# Server Configuration
PORT=5000
MONGO_URI=mongodb+srv://your_user:your_password@cluster.mongodb.net/your_db?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
API_BASE_URL=http://localhost:5000

# AI Configuration (Google Gemini from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# AI Configuration (OpenRouter/OpenAI)
OPENROUTER_API_KEY=your_openrouter_or_openai_key_here

# Auth Configuration (Google Login)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Frontend Configuration (Vite)
VITE_API_URL=http://localhost:5000
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
